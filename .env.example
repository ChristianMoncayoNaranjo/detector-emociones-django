# Copia este archivo como ".env" y ajusta los valores
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-secreta
DJANGO_DEBUG=True
DB_NAME=emociones_db
DB_USER=postgres
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=5432
# Indice de la camara (0 = camara por defecto)
CAMERA_INDEX=0
# Pon 1 solo si quieres probar rapido con SQLite (el entregable usa PostgreSQL)
USE_SQLITE=0
